# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android / local SDK config — never commit machine-specific paths
local.properties

# Secrets & signing — see CLAUDE.md security standards. Never commit these.
*.jks
*.keystore
keystore.properties
*.p12
*.pem
secrets.properties

# IDE
.idea/
*.iml
.kotlin/
captures/

# OS
.DS_Store
Thumbs.db

# Build outputs
*.apk
*.aab
*.ap_
*.dex

# Map tile build — inputs and outputs are hundreds of MB to tens of GB.
# Reproduced by infra/tiles/build-tiles.sh, never committed.
infra/tiles/work/
infra/tiles/dist/
# Planetiler resolves this relative to its working directory. build-tiles.sh keeps it out of
# the repo; this is the safety net if it is ever run from a checkout by hand.
/data/
*.osm.pbf
*.pmtiles
*.mbtiles

# M2.1 Sports Tracker export output — the developer's real location history, plus a raw API
# response that carries account identifiers. Never committed. See tools/sports-tracker-export.
tools/sports-tracker-export/out/
# Session tokens, wherever someone parks one.
*.token
sports-tracker-token*
