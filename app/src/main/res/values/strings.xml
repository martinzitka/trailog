    <string name="detail_stat_average_speed">Average speed</string>
    <string name="detail_stat_max_speed">Max speed</string>
    <!-- %1$d is a count of recording segments; more than one means the recording had gaps. -->
    <plurals name="detail_segment_note">
        <item quantity="one">Recorded in one unbroken segment.</item>
        <item quantity="other">Recorded in %1$d segments — gaps are shown as breaks, never joined
            by a straight line.</item>
    </plurals>

    <!-- Activity detail — charts. -->
    <string name="detail_chart_elevation">Elevation</string>
    <string name="detail_chart_speed">Speed</string>
    <string name="detail_chart_elevation_cd">Elevation profile against distance</string>
    <string name="detail_chart_speed_cd">Speed profile against distance</string>
    <string name="detail_chart_no_elevation">No altitude was recorded for this activity.</string>
    <string name="detail_chart_no_speed">Not enough fixes to plot a speed profile.</string>

    <!-- Activity detail — splits table. -->
    <!-- The interval is named by the chips under this heading, not by the heading, so that it
         stays true at 5 km and in imperial alike. -->
    <string name="detail_splits_title">Splits</string>
    <string name="detail_splits_empty">Too short to split at this interval.</string>
    <string name="detail_splits_column_split">Split</string>
    <string name="detail_splits_column_time">Time</string>
    <string name="detail_splits_column_speed">Speed</string>
    <string name="detail_splits_column_gain">Gain</string>
    <!-- %1$d is the split number, e.g. the 3rd kilometre. -->
    <string name="detail_splits_row_cd">Kilometre %1$d</string>
    <!-- Marks a final split shorter than a full lap; %1$s is its real length. -->
    <string name="detail_splits_partial">%1$s</string>

