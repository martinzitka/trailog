    <!-- Sensors — location permission missing. -->
    <string name="sensors_permission_title">GPS readings need location permission</string>
    <string name="sensors_permission_body">Without precise location Trailog cannot read the
        receiver, so the GPS rows below stay empty. Other diagnostics still work.</string>
    <string name="sensors_permission_grant">Grant location</string>

    <!-- Settings. -->
    <string name="settings_title">Settings</string>
    <string name="settings_subtitle">Every setting here changes something. Options arrive
        alongside the features that read them.</string>

    <!-- Settings — units. -->
    <string name="settings_group_units">Units</string>
    <string name="settings_units_metric">Metric</string>
    <string name="settings_units_metric_detail">Kilometres, metres, km/h</string>
    <string name="settings_units_imperial">Imperial</string>
    <string name="settings_units_imperial_detail">Miles, feet, mph</string>
    <string name="settings_units_note">Changes how figures are displayed. Your recordings are
        always stored in metric, so switching back and forth loses nothing.</string>

    <!-- Settings — appearance. -->
    <string name="settings_group_appearance">Appearance</string>
    <string name="settings_theme_label">Theme</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_dynamic_colour_label">Material You colours</string>
    <string name="settings_dynamic_colour_body">Take the palette from your wallpaper instead of
        using Trailog\'s own green.</string>

    <!-- Settings — recording. -->
    <string name="settings_group_recording">Recording</string>
    <string name="settings_keep_screen_on_label">Keep screen on while recording</string>
    <string name="settings_keep_screen_on_body">Useful on a handlebar mount. Costs battery on long
        rides, so it stays off unless you turn it on. Recording itself never needs the screen.</string>

    <!-- Settings — map. -->
    <string name="settings_group_map">Map</string>
    <string name="settings_show_trails_label">Show paths and trails</string>
    <string name="settings_show_trails_body">Footpaths, cycleways, bridleways and MTB trails,
        drawn as dashed lines over the map.</string>
    <string name="settings_show_trails_note">Paths only exist in the map data from zoom 14, so
        this changes nothing until you pinch in past street level. Forest tracks are roads and
        are always drawn.</string>

    <!-- Settings — data. -->
    <string name="settings_group_data">Data</string>
    <string name="settings_export_all_label">Export all activities</string>
    <string name="settings_export_all_body">Every ride as a GPX file, in one zip. Works offline
        and needs no account.</string>
    <string name="settings_export_all_note">Recording gaps stay as separate track segments, so
        nothing is joined up by a straight line. Your recordings are not changed or removed.</string>
    <string name="settings_export_starting">Working out what to export…</string>
    <string name="settings_export_running">Exporting %1$d of %2$d…</string>
    <plurals name="settings_export_done">
        <item quantity="one">Exported %d activity.</item>
        <item quantity="other">Exported %d activities.</item>
    </plurals>
    <string name="settings_export_empty">Nothing to export yet — record an activity first.</string>
    <string name="settings_export_failed">Couldn’t write the export file. Nothing on your device
        was changed.</string>

