    <!-- Record screen — map / live trace. -->
    <string name="record_map_recenter">Re-centre</string>
    <string name="record_map_recenter_cd">Re-centre the map on your position</string>
    <string name="record_trace_empty">Waiting for your first GPS fix…</string>

    <!-- Record screen — ready / idle. -->
    <string name="record_ready_hint">Ready to record. Pick an activity type and start.</string>

    <!-- Record screen — permissions. -->
    <string name="record_permissions_missing_title">Location permission needed</string>
    <string name="record_permissions_missing_body">Trailog records your route using GPS, so it
        needs location access before it can start. No location data ever leaves your control.</string>
    <string name="record_permission_fine">Precise location</string>
    <string name="record_permission_background">Location “Allow all the time”</string>
    <string name="record_permission_notifications">Notifications</string>
    <string name="record_permission_granted">granted</string>
    <string name="record_permission_denied">not granted</string>
    <string name="record_grant_foreground">Grant location &amp; notifications</string>
    <string name="record_request_background">Set location to “Allow all the time”</string>
    <string name="record_open_settings">Open app settings</string>
    <string name="record_background_rationale">“Allow all the time” is what lets Trailog pick your
        recording back up after a phone restart. Without it, a reboot mid-ride cannot resume
        recording. Grant it in system settings under Location.</string>
    <string name="record_notifications_rationale">Android needs notification permission to show the
        ongoing recording notification the tracker runs behind.</string>

    <!-- Record screen — battery optimisation. -->
    <string name="record_battery_warning_title">Battery optimisation is on</string>
    <string name="record_battery_warning_body">Your phone may kill recording in the background to
        save power. Exempt Trailog from battery optimisation so long rides record to the end.</string>
    <string name="record_battery_fix">Exempt Trailog</string>

    <!-- Record screen — stop confirmation. -->
    <string name="record_stop_confirm_title">Stop recording?</string>
    <string name="record_stop_confirm_body">This finishes and saves the activity. An accidental
        stop loses a ride.</string>
    <string name="record_stop_confirm_confirm">Stop &amp; save</string>
    <string name="record_stop_confirm_dismiss">Keep recording</string>

    <!-- Record screen — naming the ride just saved (M1.8). The activity is already saved by the
         time this appears; both fields are optional and skipping keeps the ride. -->
    <string name="record_name_title">Name this ride?</string>
    <string name="record_name_body">Saved. Add a name while you still remember where you
        went — or skip, and Trailog will list it by type and date.</string>
    <string name="record_name_name">Name</string>
    <string name="record_name_notes">Notes</string>
    <string name="record_name_save">Save</string>
    <string name="record_name_skip">Skip</string>

    <!-- Record screen — interrupted-session recovery. -->
    <string name="record_interrupted_title">Interrupted activity found</string>
    <!-- %1$s is a coarse gap length, e.g. "42m" or "2h 10m". -->
    <string name="record_interrupted_body">Recording was interrupted %1$s ago. Resume it into a
        new segment, or finish and save what was recorded.</string>
    <string name="record_interrupted_resume">Resume</string>
    <string name="record_interrupted_finish">Finish &amp; save</string>
    <!-- %1$s is a coarse gap length. Shown when recovery resumed automatically after a short gap. -->
    <string name="record_recovery_auto_resumed">Recording resumed after a %1$s gap, in a new
        segment.</string>

    <!-- History screen. -->
    <string name="history_loading">Loading your activities…</string>
    <string name="history_empty_title">No activities yet</string>
    <string name="history_empty_body">Rides, runs, hikes and walks you record show up here, newest
        first. Open the Record tab, pick an activity type and tap Start recording — everything
        stays on your phone.</string>
    <string name="history_empty_action">Go to Record</string>
    <string name="history_error_title">Couldn’t load your activities</string>
    <string name="history_error_body">Your recordings are safe on this phone — only the list
        failed to load.</string>
    <string name="history_error_retry">Try again</string>
    <!-- Row subtitle: %1$s is the activity type, %2$s the date it was recorded. -->
    <string name="history_row_subtitle">%1$s · %2$s</string>
    <string name="history_stat_distance">Distance</string>
    <string name="history_stat_duration">Duration</string>
    <string name="history_stat_elevation_gain">Elev. gain</string>
    <!-- Shown in place of a figure whose statistics have not been computed yet. -->
    <string name="history_stat_pending">—</string>

    <!-- Activity detail — chrome. -->
    <string name="detail_loading">Loading activity…</string>
    <string name="detail_back">Back</string>
    <string name="detail_gone_title">Activity deleted</string>
    <string name="detail_gone_body">This activity and its recorded points are gone.</string>
    <string name="detail_gone_action">Back to History</string>
    <!-- Shown while the statistics cache is being rebuilt; figures are computed live meanwhile. -->
    <string name="detail_stats_pending">Figures computed from raw points — the cache is still
        being rebuilt.</string>

    <!-- Activity detail — map. -->
    <string name="detail_map_cd">Map of the recorded route</string>
    <string name="detail_map_empty">This activity has no recorded positions.</string>
    <string name="detail_map_refit_cd">Zoom the map back to the whole route</string>

